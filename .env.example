# ==============================================================================
# MEDVERSE 3D — VERCEL ENVIRONMENT VARIABLES (.env.example)
# NEVER commit your real .env file to GitHub. Add these in Vercel Project Settings.
# ==============================================================================

# 1. REQUIRED FOR LIVE AI MEDICAL TUTOR (/api/tutor serverless function):
# Get your key from Google AI Studio: https://aistudio.google.com/apikey
# IMPORTANT: Do NOT prefix with VITE_ so it stays strictly server-side!
GEMINI_API_KEY=your_google_ai_studio_gemini_api_key_here

# Optional: Gemini model name (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# 2. OPTIONAL — ONLY IF YOU ENABLE CLOUD SYNC / FIREBASE AUTH & FIRESTORE LATER:
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_APP_ID=
